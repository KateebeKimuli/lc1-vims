# ============================================================
# LC1 VIMS SMS PROXY — CREDENTIALS FILE
# ============================================================
# INSTRUCTIONS:
#   1. Make a COPY of this file and name it exactly:  .env
#      (The dot at the start is important — it must be .env)
#
#   2. Open the .env file and fill in your actual credentials
#      between the quotes below.
#
#   3. NEVER share the .env file or paste its contents anywhere.
#      It contains your private API key.
#
#   4. The .env file stays on your computer only.
#      It is listed in .gitignore so it will never be uploaded.
#
# WHERE TO FIND YOUR CREDENTIALS:
#   - Log in at: https://account.africastalking.com
#   - Your USERNAME is shown on the dashboard (top-left)
#   - Your API KEY is under: Settings → API Key → Generate
# ============================================================

# Your Africa's Talking account username
AT_USERNAME=

# Your Africa's Talking API key (from Settings → API Key)
AT_API_KEY=

# Port the proxy server listens on (3001 is fine, change if needed)
PORT=3001

# Your Africa's Talking Sender ID (must be approved by AT)
# If you don't have one yet, leave this blank — AT will use a shared number
AT_SENDER_ID=MOLG-LC1
